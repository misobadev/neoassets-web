# Base URL of the NeoAssets API (Go service).
# Local dev: http://localhost:8090 (the dockerized API service)
# Production: https://neoassets.dev
VITE_ASSETS_API_URL=http://localhost:8090

# Public base URL of the R2 CDN that serves published pack files.
# Production: https://cdn.neoassets.dev
VITE_CDN_BASE=https://cdn.neoassets.dev